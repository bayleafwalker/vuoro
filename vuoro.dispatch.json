      "required_on_change": true
    }
  ],
  "hybrid": {
    "enabled": true,
    "worker_routes": ["mechanical_bulk"],
    "commands": {
      "vuoro.client.tests": "uv run --package vuoro-client --extra test pytest packages/vuoro-client/tests",
      "vuoro.service.tests": "uv run --package vuoro-service --extra test pytest packages/vuoro-service/tests",
      "vuoro.boundaries": "uv build --package vuoro-client --wheel --out-dir dist/vuoro-client && uv build --package vuoro-service --wheel --out-dir dist/vuoro-service && uv run pytest tests/test_distribution_boundaries.py",
      "vuoro.suite": "uv run pytest"
    },
    "protected_paths": [
      "deploy/**",
      "vuoro.dispatch.json",
      "AGENTS.md",
      ".agents/**",
      ".github/**",
      "pyproject.toml",
      "uv.lock"
    ],
    "worktree_root": "/tmp/vuoro-hybrid/worktrees",
    "max_timeout_seconds": 1800,
    "max_cost_usd": 3.0,
    "soft_token_ceiling": 500000,
    "hard_token_ceiling": 1000000,
    "notes": [
      "Only low-risk mechanical implementation with frozen interfaces, an externally defined worker-immutable oracle, and coordinator-authored discriminating gates is worker-eligible. Task size alone never grants eligibility.",
      "Test-oracle and parity-fixture construction, tests as the primary deliverable, cross-layer behavioural proof, and client authority, public contract, or compatibility decisions remain coordinator-owned.",
      "Deployment packaging and compatibility/migration semantics are coordinator-only.",
      "The current devbox hybrid dispatcher is one bounded patch-worker implementation, not the portable execution contract. Vuoro does not own Sprintctl plan semantics, Actionq claims or leases, runner harness internals, candidate publication, or Auditctl findings.",
      "Portable runner envelopes carry no claim tokens or provider credentials. Candidate Git bundles, receipts, integration topology, and disposable-runner isolation are governed by docs/architecture/portable-execution.md and owner-repository acceptance evidence.",
      "Worker packets carry no VUORO_ or database credentials; every registered command runs against the repository's own fixtures.",
      "Every registered command must be self-contained in a fresh exact-commit worktree: the coordinator runs it cold before inference, and a command depending on artifacts from an earlier step fails that gate. vuoro.boundaries therefore builds both wheels itself rather than assuming dist/ is populated."
    ]
  },
  "verification": {
    "command_families": ["unit", "architecture", "docs", "full-suite"],
    "targeted_first": true,
    "commands": [
      "uv run --package vuoro-client --extra test pytest packages/vuoro-client/tests",
      "uv run --package vuoro-service --extra test pytest packages/vuoro-service/tests",
      "uv build --package vuoro-client --wheel --out-dir dist/vuoro-client",
      "uv build --package vuoro-service --wheel --out-dir dist/vuoro-service",
      "uv run pytest",
      "python /projects/dev/agentops/templates/dispatch/scripts/validate_verification_artifacts.py --root ."
    ]
  },
  "hooks": {
    "level": "verification",
    "publishers": ["git", "dispatcher-gate", "github"]
  }
