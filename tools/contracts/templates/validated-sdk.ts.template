  methods[name]=async(options:any)=>{
   if(!options||typeof options!=="object"||Array.isArray(options))throw new ContractError("parameter");
   validateJsonValue(options);pathMatch(options,op);const responseContext:any={};
   const guardFetch=(async(input:any,init:any)=>{const req=input instanceof Request?input:new Request(new URL(input,baseUrl),init);validateWire(req,op,options,baseUrl);const raw=new Uint8Array(await req.clone().arrayBuffer());if(op.request===null)check(null,undefined,raw.length===0);else{if(raw.length>op.requestMaxBytes)throw new ContractError("body_limit");check(op.request,strictDecode(raw,op.requestMaxBytes),false)}const response=await fetcher(req);const status=String(response.status);if(!Object.hasOwn(op.responses,status)){try{await response.body?.cancel()}catch{}throw new ContractError("status")}const id=op.responses[status],cap=op.responseMaxBytes[status];const bytes=await bounded(response,cap??0);const body=id===null?ABSENT:strictDecode(bytes,cap);check(id,body,id===null);responseContext.status=Number(status);responseContext.body=body;responseContext.content=bytes;return new Response(bytes.length?bytes:null,{status:Number(status),headers:response.headers});}) as typeof fetch;
