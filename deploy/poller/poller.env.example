# Copy to /etc/vuoro/poller.env (systemd) or a `.env` next to compose.yaml
# (compose), fill in real values, and set file permissions to 0600 -- this
# holds credentials. Never commit a filled-in copy.

# Static bearer this host's internal MCP server accepts, and the poller
# presents. One shared secret between the two local processes -- matching
# the static-bearer auth mode decided for E1 (agentops#2470) rather than a
# second auth model invented for the internal path.
VUORO_POLLER_TOKEN=

# Registering the Managed Agents agent and minting its credential are
# operator, vendor-side steps (platform.claude.com/docs/en/managed-agents) --
# this deployment config does not perform them. Fill these in only after
# that registration exists.
VUORO_MANAGED_AGENTS_BASE_URL=
VUORO_MANAGED_AGENTS_TOKEN=
VUORO_MANAGED_AGENTS_AGENT_ID=
