{
  "openapi": "3.0.0",
  "info": {
    "title": "EC-00 disposable OA candidate",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/v1/requests": {
      "post": {
        "operationId": "publish",
        "parameters": [],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        }
      }
    },
    "/v1/requests/{requestId}": {
      "patch": {
        "operationId": "revise",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviseRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "MutationResult": {
        "type": "object",
        "required": [
          "requestId",
          "revision"
        ],
        "properties": {
          "requestId": {
            "type": "string"
          },
          "revision": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "PublishRequest": {
        "type": "object",
        "required": [
          "requestId",
          "objective"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Decimal string identifier; preserved above JavaScript's safe integer range."
          },
          "objective": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "ReviseRequest": {
        "type": "object",
        "required": [
          "requestId",
          "objective"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "description": "Decimal string identifier; preserved above JavaScript's safe integer range."
          },
          "expectedRevision": {
            "type": "integer",
            "format": "int64",
            "nullable": true
          },
          "objective": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        }
      }
    }
  }
}
