{
  "openapi": "3.0.0",
  "info": {
    "title": "EC-00 schema-validated OA candidate v3",
    "version": "0.0.0"
  },
  "tags": [],
  "paths": {
    "/v3/requests": {
      "post": {
        "operationId": "publish",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdempotencyKey"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PublishRequest"
              }
            }
          }
        }
      }
    },
    "/v3/requests/{requestId}": {
      "patch": {
        "operationId": "revise",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdempotencyKey"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MutationResult"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviseRequest"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "readRequest",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RequestRead"
                }
              }
            }
          }
        }
      }
    },
    "/v3/requests/{requestId}/artifact/{materialRevision}": {
      "get": {
        "operationId": "readArtifact",
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            }
          },
          {
            "name": "materialRevision",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/Revision"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The request has succeeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ArtifactRead"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ArtifactRead": {
        "type": "object",
        "required": [
          "materialRevision",
          "materialDigest",
          "artifactDigest",
          "keyId",
          "originalBytes",
          "envelopeBytes",
          "signature"
        ],
        "properties": {
          "materialRevision": {
            "$ref": "#/components/schemas/Revision"
          },
          "materialDigest": {
            "type": "string"
          },
          "artifactDigest": {
            "type": "string"
          },
          "keyId": {
            "type": "string"
          },
          "originalBytes": {
            "type": "string",
            "format": "byte"
          },
          "envelopeBytes": {
            "type": "string",
            "format": "byte"
          },
          "signature": {
            "type": "string",
            "format": "byte"
          }
        },
        "additionalProperties": {}
      },
      "CommandBody": {
        "type": "object",
        "required": [
          "objective"
        ],
        "properties": {
          "objective": {
            "type": "string",
            "maxLength": 65536
          },
          "note": {
            "type": "string",
            "nullable": true,
            "maxLength": 65536
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "IdempotencyKey": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256
      },
      "MutationResult": {
        "type": "object",
        "required": [
          "requestId",
          "revision"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "additionalProperties": {}
      },
      "PublishRequest": {
        "type": "object",
        "required": [
          "requestId",
          "body",
          "dependants"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "body": {
            "$ref": "#/components/schemas/CommandBody"
          },
          "dependants": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 64
          },
          "artifact": {
            "$ref": "#/components/schemas/SignedArtifactInput"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "RequestBody": {
        "type": "object",
        "required": [
          "objective"
        ],
        "properties": {
          "objective": {
            "type": "string"
          },
          "note": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": {}
      },
      "RequestId": {
        "type": "string",
        "pattern": "^[1-9][0-9]{0,39}$(?![\\s\\S])"
      },
      "RequestRead": {
        "type": "object",
        "required": [
          "requestId",
          "revision",
          "materialRevision",
          "state",
          "body",
          "reported",
          "verified",
          "createdSeq"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "revision": {
            "$ref": "#/components/schemas/Revision"
          },
          "materialRevision": {
            "$ref": "#/components/schemas/Revision"
          },
          "state": {
            "$ref": "#/components/schemas/RequestState"
          },
          "body": {
            "$ref": "#/components/schemas/RequestBody"
          },
          "reported": {
            "type": "boolean"
          },
          "verified": {
            "type": "boolean"
          },
          "evidenceRef": {
            "type": "string",
            "nullable": true
          },
          "artifactDecisionDigest": {
            "type": "string",
            "nullable": true
          },
          "createdSeq": {
            "$ref": "#/components/schemas/Revision"
          }
        },
        "additionalProperties": {}
      },
      "RequestState": {
        "type": "string",
        "enum": [
          "open",
          "resolved"
        ]
      },
      "ReviseRequest": {
        "type": "object",
        "required": [
          "requestId",
          "expectedRevision",
          "body"
        ],
        "properties": {
          "requestId": {
            "$ref": "#/components/schemas/RequestId"
          },
          "expectedRevision": {
            "$ref": "#/components/schemas/Revision"
          },
          "body": {
            "$ref": "#/components/schemas/CommandBody"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      },
      "Revision": {
        "type": "string",
        "pattern": "^(0|[1-9][0-9]{0,17}|[1-8][0-9]{18}|9[0-1][0-9]{17}|92[0-1][0-9]{16}|922[0-2][0-9]{15}|9223[0-2][0-9]{14}|92233[0-6][0-9]{13}|922337[0-1][0-9]{12}|92233720[0-2][0-9]{10}|922337203[0-5][0-9]{9}|9223372036[0-7][0-9]{8}|92233720368[0-4][0-9]{7}|922337203685[0-3][0-9]{6}|9223372036854[0-6][0-9]{5}|92233720368547[0-6][0-9]{4}|922337203685477[0-4][0-9]{3}|9223372036854775[0-7][0-9]{2}|922337203685477580[0-6]|9223372036854775807)$(?![\\s\\S])"
      },
      "SignedArtifactInput": {
        "type": "object",
        "required": [
          "artifactDigest",
          "artifactKeyId",
          "artifactBytes",
          "artifactEnvelope",
          "artifactSignature"
        ],
        "properties": {
          "artifactDigest": {
            "type": "string"
          },
          "artifactKeyId": {
            "type": "string"
          },
          "artifactBytes": {
            "type": "string",
            "format": "byte"
          },
          "artifactEnvelope": {
            "type": "string",
            "format": "byte"
          },
          "artifactSignature": {
            "type": "string",
            "format": "byte"
          }
        },
        "additionalProperties": {
          "not": {}
        }
      }
    }
  }
}
