{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@bufbuild/protobuf": [
        "node_modules/@bufbuild/protobuf/dist/esm/index.d.ts"
      ],
      "@bufbuild/protobuf/*": [
        "node_modules/@bufbuild/protobuf/dist/esm/*/index.d.ts"
      ]
    }
  },
  "files": [
    "run_typescript_clients.ts"
  ]
}
