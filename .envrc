# Sprintctl authority for normal Vuoro agent work is the Vuoro served adapter.
#
# Keep the direct store path out of this repository's default session: recovery
# tooling is explicit and must not become a silent fallback for a blind agent.
export SPRINTCTL_BACKEND=served
export SPRINTCTL_VUORO_PROFILE=/projects/dev/agentops/templates/dispatch/environment-record/profiles/workstation-vuoro-shared.json
export SPRINTCTL_DB="$PWD/.sprintctl/sprintctl.db"
unset SPRINTCTL_URL

# A host-specific profile (for example devbox-agent) is untracked and sourced
# last.  It can change endpoint identity only; the served backend remains the
# checked-in contract.
source_env_if_exists .envrc.local
